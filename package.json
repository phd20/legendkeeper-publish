{
  "name": "legendkeeper-publish",
  "version": "0.1.0",
  "description": "Publish Obsidian vault changes to LegendKeeper",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src"
  },
  "license": "MIT",
  "dependencies": {
    "@legendkeeper/sdk": "^4.1.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.14.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/phd20/legendkeeper-publish.git"
  },
  "bugs": {
    "url": "https://github.com/phd20/legendkeeper-publish/issues"
  },
  "homepage": "https://github.com/phd20/legendkeeper-publish"
}
